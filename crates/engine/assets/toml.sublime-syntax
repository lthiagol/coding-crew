%YAML 1.2
---
# TOML for the engine's fenced code. Syntect's default set has no TOML, so
# `toml` fell back to YAML. Keys and table names take the scopes the markdown
# code themes map to a role (`entity.name.tag`, `entity.name.type`), and the
# rest follow Sublime Text's TOML names.
name: TOML
file_extensions:
  - toml
scope: source.toml
contexts:
  main:
    - include: comment
    - match: '^\s*(\[\[?)'
      captures:
        1: punctuation.definition.table.toml
      push: table-name
    - match: '[A-Za-z0-9_-]+(?=\s*[.=])'
      scope: entity.name.tag.toml
    - include: string
    - match: '\.'
      scope: punctuation.separator.dot.toml
    - match: '='
      scope: keyword.operator.assignment.toml
      push: value

  comment:
    - match: '#.*$'
      scope: comment.line.number-sign.toml

  table-name:
    - meta_scope: entity.name.type.toml
    - match: '\]\]?'
      scope: punctuation.definition.table.toml
      pop: true
    - match: '$'
      pop: true
    - match: '[A-Za-z0-9_-]+'
      scope: entity.name.type.toml
    - match: '\.'
      scope: punctuation.separator.dot.toml
    - include: string

  value:
    - include: comment
    - include: value-item
    - match: '\['
      scope: punctuation.definition.array.begin.toml
      push: array
    - match: '\{'
      scope: punctuation.definition.inline-table.begin.toml
      push: inline-table
    - match: '$'
      pop: true

  array:
    - include: comment
    - include: value-item
    - match: '\['
      scope: punctuation.definition.array.begin.toml
      push: array
    - match: '\{'
      scope: punctuation.definition.inline-table.begin.toml
      push: inline-table
    - match: ','
      scope: punctuation.separator.comma.toml
    - match: '\]'
      scope: punctuation.definition.array.end.toml
      pop: true

  inline-table:
    - match: '[A-Za-z0-9_-]+(?=\s*=)'
      scope: entity.name.tag.toml
    - include: string
    - match: '='
      scope: keyword.operator.assignment.toml
      push: inline-value
    - match: ','
      scope: punctuation.separator.comma.toml
    - match: '\}'
      scope: punctuation.definition.inline-table.end.toml
      pop: true

  inline-value:
    - match: '(?=[,}])'
      pop: true
    - include: value-item
    - match: '\['
      scope: punctuation.definition.array.begin.toml
      push: array
    - match: '\{'
      scope: punctuation.definition.inline-table.begin.toml
      push: inline-table

  value-item:
    - include: string
    - match: '\d{4}-\d{2}-\d{2}(?:[Tt ]\d{2}:\d{2}:\d{2}(?:\.\d+)?(?:[Zz]|[+-]\d{2}:\d{2})?)?|\d{2}:\d{2}:\d{2}(?:\.\d+)?'
      scope: constant.numeric.datetime.toml
    - match: '[+-]?(?:inf|nan)\b'
      scope: constant.numeric.float.toml
    - match: '[+-]?(?:0x[0-9A-Fa-f_]+|0o[0-7_]+|0b[01_]+)\b'
      scope: constant.numeric.integer.toml
    - match: '[+-]?\d[\d_]*(?:\.\d[\d_]*)?(?:[eE][+-]?\d[\d_]*)?\b'
      scope: constant.numeric.toml
    - match: '\b(?:true|false)\b'
      scope: constant.language.boolean.toml

  string:
    - match: '"""'
      scope: punctuation.definition.string.begin.toml
      push: multiline-basic-string
    - match: "'''"
      scope: punctuation.definition.string.begin.toml
      push: multiline-literal-string
    - match: '"'
      scope: punctuation.definition.string.begin.toml
      push: basic-string
    - match: "'"
      scope: punctuation.definition.string.begin.toml
      push: literal-string

  basic-string:
    - meta_scope: string.quoted.double.basic.toml
    - match: '\\(?:[btnfr"\\]|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})'
      scope: constant.character.escape.toml
    - match: '"'
      scope: punctuation.definition.string.end.toml
      pop: true
    - match: '$'
      pop: true

  literal-string:
    - meta_scope: string.quoted.single.literal.toml
    - match: "'"
      scope: punctuation.definition.string.end.toml
      pop: true
    - match: '$'
      pop: true

  multiline-basic-string:
    - meta_scope: string.quoted.double.block.toml
    - match: '\\(?:[btnfr"\\]|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|\s*$)'
      scope: constant.character.escape.toml
    - match: '"""'
      scope: punctuation.definition.string.end.toml
      pop: true

  multiline-literal-string:
    - meta_scope: string.quoted.single.block.toml
    - match: "'''"
      scope: punctuation.definition.string.end.toml
      pop: true
